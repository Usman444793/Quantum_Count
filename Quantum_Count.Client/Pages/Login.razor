@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Quantum_Count.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login - Quantum Count</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">📦</div>
        <h1>Welcome Back</h1>
        <p class="auth-subtitle">Sign in to Quantum Count</p>
        <div class="form-group">
            <label>Email Address</label>
            <input @bind="email"type="email"class="form-input"placeholder="Enter your email" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input @bind="password"type="password"class="form-input"placeholder="Enter your password" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">@errorMessage</div>
        }
        <button class="auth-button"@onclick="HandleLogin"disabled="@isLoading">
            @if (isLoading)
            {
                <span>Signing in...</span>
            }
            else
            {
                <span>Sign In</span>
            }
        </button>
        <div class="auth-footer">
            <span>Don't have an account?</span>
            <a href="/register">Create Account</a>
        </div>
    </div>
</div>
@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool isLoading;
    private string? errorMessage;
    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Email and password are required.";
            return;
        }
        isLoading = true;
        errorMessage = null;
        try
        {
            var result = await AuthService.LoginAsync(email,password);

            if (result is not null)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage ="Invalid email or password.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect to the server.";
        }
        finally
        {
            isLoading = false;
        }
    }
}