@page "/register"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Quantum_Count.Client.Models
@using Quantum_Count.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
<PageTitle>Create Account - Quantum Count</PageTitle>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">📦</div>
        <h1>Create Account</h1>
        <p class="auth-subtitle">Start using Quantum Count</p>
        <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }
            <div class="form-group">
                <label>Full Name</label>
                <InputText @bind-Value="registerModel.FullName"class="form-input"placeholder="Enter your full name" />
                <ValidationMessage For="@(() => registerModel.FullName)" />
            </div>
            <div class="form-group">
                <label>Email Address</label>
                <InputText @bind-Value="registerModel.Email"class="form-input"type="email"placeholder="Enter your email address" />
                <ValidationMessage For="@(() => registerModel.Email)" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <InputText @bind-Value="registerModel.Password"class="form-input"type="password"placeholder="Enter password" />
                <ValidationMessage For="@(() => registerModel.Password)" />
            </div>
            <button type="submit"class="auth-button"disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Create Account</span>
                }
            </button>
        </EditForm>
        <div class="auth-footer">
            <span>Already have an account?</span>
            <a href="/login">Sign in</a>
        </div>
    </div>
</div>
@code {
    private RegisterRequest registerModel = new();
    private bool isLoading;
    private string? errorMessage;
    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var result = await AuthService.RegisterAsync(registerModel.FullName,registerModel.Email,registerModel.Password);
            if (result is not null)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage ="Unable to create account.";
            }
        }
        catch (Exception)
        {
            errorMessage ="Unable to connect to the server.";
        }
        finally
        {
            isLoading = false;
        }
    }
}