@using MudBlazor
@page "/reports"
@attribute [Authorize]
@using System.Net.Http.Json
@using Quantum_Count.DTO.Reports
@inject HttpClient Http
<PageTitle>Reports & Analytics</PageTitle>
<div class="reports-page">
    <div class="reports-header">
        <div>
            <h1>Reports & Analytics</h1>
            <p>Detailed insights into inventory, procurement, equipment and projects.</p>
        </div>
        <div class="header-actions">
            <a href="@GetExportUrl("excel")"
               class="export-btn excel-btn"
               download>
                <span>▣</span>
                Export Excel
            </a>
        <a href=@GetExportUrl("pdf") class="export-btn">
            <span>▤</span> Export PDF
        </a>
        <button class="refresh-btn" @onclick="LoadReportsAsync">
            ↻ Refresh
        </button>
        </div>
    </div>
    <div class="filter-card">
        <div class="filter-title">
            <h3>Report Filters</h3>
            <span>Apply a date range to time-based reports</span>
        </div>
        <div class="filters">
            <div class="filter-group">
                <label>From Date</label>
                <input type="date" @bind="fromDate" />
            </div>
            <div class="filter-group">
                <label>To Date</label>
                <input type="date" @bind="toDate" />
            </div>
            <button class="generate-btn" @onclick="LoadReportsAsync">
                Generate Report
            </button>
            <button class="clear-btn" @onclick="ClearFilters">
                Clear
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="error-message">
                @errorMessage
            </div>
        }
    </div>
    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Loading reports...</p>
        </div>
    }
    else
    {
        <div class="report-tabs">
            <button class="@GetTabClass("inventory")"
                    @onclick="@(() => activeTab = "inventory")">
                Inventory
            </button>
            <button class="@GetTabClass("stock")"
                    @onclick="@(() => activeTab = "stock")">
                Stock Movement
            </button>
            <button class="@GetTabClass("procurement")"
                    @onclick="@(() => activeTab = "procurement")">
                Procurement
            </button>
            <button class="@GetTabClass("equipment")"
                    @onclick="@(() => activeTab = "equipment")">
                Equipment
            </button>
            <button class="@GetTabClass("projects")"
                    @onclick="@(() => activeTab = "projects")">
                Projects
            </button>
        </div>
        @if (activeTab == "inventory")
        {
            <div class="report-section">
                <div class="section-heading">
                    <div>
                        <h2>Inventory Report</h2>
                        <p>Current inventory position and stock health.</p>
                    </div>
                </div>
                @if (inventorySummary is not null)
                {
                    <div class="stat-grid">
                        <div class="stat-card">
                            <span>Total Materials</span>
                            <strong>@inventorySummary.TotalMaterials</strong>
                        </div>
                        <div class="stat-card">
                            <span>Total Quantity</span>
                            <strong>@inventorySummary.TotalQuantity.ToString("N2")</strong>
                        </div>
                        <div class="stat-card">
                            <span>Inventory Value</span>
                            <strong>
                                @inventorySummary.TotalInventoryValue.ToString("N2")
                            </strong>
                        </div>
                        <div class="stat-card warning">
                            <span>Low Stock</span>
                            <strong>@inventorySummary.LowStockItems</strong>
                        </div>
                        <div class="stat-card danger">
                            <span>Out of Stock</span>
                            <strong>@inventorySummary.OutOfStockItems</strong>
                        </div>
                    </div>
                    <div class="report-card">
                        <div class="card-heading">
                            <h3>Inventory by Category</h3>
                            <span>@inventorySummary.Categories.Count categories</span>
                        </div>
                        @if (inventorySummary is not null && inventorySummary.Categories.Count > 0)
                        {
                            <div class="charts-grid">
                                <div class="chart-card chart-wide">
                                    <div class="chart-header">
                                        <div>
                                            <h3>Inventory by Category</h3>
                                            <p>Total inventory value across categories.</p>
                                        </div>
                                    </div>
                                    <MudChart T="double"
                                              ChartType="ChartType.Bar"
                                              ChartSeries="@InventoryChartSeries"
                                              ChartLabels="@InventoryChartLabels"
                                              Width="100%"
                                              Height="350px"
                                              MatchBoundsToSize="true" />
                                </div>

                            </div>
                        }
                        @if (inventorySummary.Categories.Count == 0)
                        {
                            <div class="empty-state">
                                No category data available.
                            </div>
                        }
                        else
                        {
                            <div class="table-wrapper">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Category</th>
                                            <th>Materials</th>
                                            <th>Quantity</th>
                                            <th>Total Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var category in inventorySummary.Categories)
                                        {
                                            <tr>
                                                <td>@category.CategoryName</td>
                                                <td>@category.MaterialCount</td>
                                                <td>@category.TotalQuantity.ToString("N2")</td>
                                                <td>@category.TotalValue.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="report-card">
                        <div class="card-heading">
                            <div>
                                <h3>Low Stock & Out of Stock</h3>
                                <span>Materials requiring attention</span>
                            </div>
                            <span class="record-count">
                                @lowStockItems.Count items
                            </span>
                        </div>
                        @if (lowStockItems.Count == 0)
                        {
                            <div class="success-state">
                                ✓ All materials are above their minimum stock level.
                            </div>
                        }
                        else
                        {
                            <div class="table-wrapper">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Material</th>
                                            <th>Category</th>
                                            <th>Current</th>
                                            <th>Minimum</th>
                                            <th>Unit</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in lowStockItems)
                                        {
                                            <tr>
                                                <td>@item.MaterialCode</td>
                                                <td>@item.MaterialName</td>
                                                <td>@item.CategoryName</td>
                                                <td>@item.CurrentQuantity.ToString("N2")</td>
                                                <td>@item.MinimumStockLevel.ToString("N2")</td>
                                                <td>@item.Unit</td>
                                                <td>
                                                    <span class="status-badge @(item.Status == "Out of Stock" ? "danger-badge" : "warning-badge")">
                                                        @item.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (activeTab == "stock")
        {
            <div class="report-section">
                <div class="section-heading">
                    <div>
                        <h2>Stock Movement Report</h2>
                        <p>Analyze inventory movement over the selected period.</p>
                    </div>
                </div>
                <div class="report-card">
                    <div class="card-heading">
                        <h3>Daily Stock Movement</h3>
                        <span>@stockMovements.Count records</span>
                    </div>
                    @if (stockMovements.Count > 0)
                    {
                        <div class="charts-grid">

                            <div class="chart-card chart-wide">
                                <div class="chart-header">
                                    <div>
                                        <h3>Stock Movement Trend</h3>
                                        <p>Daily stock-in and stock-out activity.</p>
                                    </div>
                                </div>
                                <MudChart T="double"
                                          ChartType="ChartType.Line"
                                          ChartSeries="@StockMovementChartSeries"
                                          ChartLabels="@StockMovementChartLabels"
                                          Width="100%"
                                          Height="350px"
                                          MatchBoundsToSize="true" />
                            </div>
                        </div>
                    }
                    @if (stockMovements.Count == 0)
                    {
                        <div class="empty-state">
                            No stock movement found for the selected period.
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Stock In</th>
                                        <th>Stock Out</th>
                                        <th>Returns</th>
                                        <th>Damaged</th>
                                        <th>Adjustments</th>
                                        <th>Net Movement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var movement in stockMovements)
                                    {
                                        <tr>
                                            <td>@movement.Date.ToString("dd MMM yyyy")</td>
                                            <td class="positive">
                                                +@movement.StockIn.ToString("N2")
                                            </td>
                                            <td class="negative">
                                                -@movement.StockOut.ToString("N2")
                                            </td>
                                            <td>
                                                @movement.Returns.ToString("N2")
                                            </td>
                                            <td>
                                                @movement.Damaged.ToString("N2")
                                            </td>
                                            <td>
                                                @movement.Adjustments.ToString("N2")
                                            </td>
                                            <td class="net-value">
                                                @movement.NetMovement.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="report-card">
                    <div class="card-heading">
                        <div>
                            <h3>Stock Transactions</h3>
                            <span>Detailed transaction history</span>
                        </div>
                        <span class="record-count">
                            @stockTransactions.Count transactions
                        </span>
                    </div>
                    <div class="table-wrapper">

                        <table>
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Code</th>
                                    <th>Material</th>
                                    <th>Type</th>
                                    <th>Quantity</th>
                                    <th>Reference</th>
                                    <th>Created By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in stockTransactions)
                                {
                                    <tr>
                                        <td>
                                            @(transaction.Date?.ToString("dd MMM yyyy HH:mm") ?? "—")
                                        </td>
                                        <td>
                                            @transaction.MaterialCode
                                        </td>
                                        <td>
                                            @transaction.MaterialName
                                        </td>
                                        <td>
                                            <span class="transaction-badge">
                                                @transaction.TransactionType
                                            </span>
                                        </td>
                                        <td>
                                            @transaction.Quantity.ToString("N2")
                                        </td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(transaction.Reference)
                                                ? "—"   : transaction.Reference)
                                        </td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(transaction.CreatedBy)
                                                ? "—" : transaction.CreatedBy)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        @if (activeTab == "procurement")
        {
            <div class="report-section">
                <div class="section-heading">
                    <div>
                        <h2>Procurement Report</h2>
                        <p>Purchase order and supplier analysis.</p>
                    </div>
                </div>
                @if (procurementSummary is not null)
                {
                    <div class="stat-grid">
                        <div class="stat-card">
                            <span>Total Purchase Orders</span>
                            <strong>@procurementSummary.TotalPurchaseOrders</strong>
                        </div>
                        <div class="stat-card">
                            <span>Total Purchase Value</span>
                            <strong>
                                @procurementSummary.TotalPurchaseValue.ToString("N2")
                            </strong>
                        </div>
                        <div class="stat-card">
                            <span>Draft</span>
                            <strong>@procurementSummary.DraftOrders</strong>
                        </div>
                        <div class="stat-card">
                            <span>Ordered</span>
                            <strong>@procurementSummary.OrderedOrders</strong>
                        </div>
                        <div class="stat-card">
                            <span>Partially Received</span>
                            <strong>@procurementSummary.PartiallyReceivedOrders</strong>
                        </div>
                        <div class="stat-card">
                            <span>Received</span>
                            <strong>@procurementSummary.ReceivedOrders</strong>
                        </div>
                    </div>
                    <div class="report-card">
                        <div class="card-heading">
                            <h3>Purchases by Supplier</h3>
                            <span>@procurementSummary.Suppliers.Count suppliers</span>
                        </div>
                        @if (procurementSummary is not null && procurementSummary.Suppliers.Count > 0)
                        {
                            <div class="charts-grid">
                                <div class="chart-card chart-wide">
                                    <div class="chart-header">
                                        <div>
                                            <h3>Purchases by Supplier</h3>
                                            <p>Purchase value by supplier.</p>
                                        </div>
                                    </div>
                                    <MudChart T="double"
                                              ChartType="ChartType.Bar"
                                              ChartSeries="@ProcurementChartSeries"
                                              ChartLabels="@ProcurementChartLabels"
                                              Width="100%"
                                              Height="350px"
                                              MatchBoundsToSize="true" />
                                </div>
                            </div>
                        }
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Supplier</th>
                                        <th>Orders</th>
                                        <th>Total Purchase Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var supplier in procurementSummary.Suppliers)
                                    {
                                        <tr>
                                            <td>@supplier.SupplierName</td>
                                            <td>@supplier.OrderCount</td>
                                            <td>
                                                @supplier.TotalPurchaseValue.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
        @if (activeTab == "equipment")
        {
            <div class="report-section">
                <div class="section-heading">
                    <div>
                        <h2>Equipment Report</h2>
                        <p>Equipment availability, usage and valuation.</p>
                    </div>
                </div>
                @if (equipmentSummary is not null)
                {
                    <div class="stat-grid">
                        <div class="stat-card">
                            <span>Total Equipment</span>
                            <strong>@equipmentSummary.TotalEquipment</strong>
                        </div>
                        <div class="stat-card">
                            <span>Available</span>
                            <strong>@equipmentSummary.Available</strong>
                        </div>
                        <div class="stat-card">
                            <span>In Use</span>
                            <strong>@equipmentSummary.InUse</strong>
                        </div>
                        <div class="stat-card warning">
                            <span>Maintenance</span>
                            <strong>@equipmentSummary.Maintenance</strong>
                        </div>
                        <div class="stat-card danger">
                            <span>Damaged</span>
                            <strong>@equipmentSummary.Damaged</strong>
                        </div>
                        <div class="stat-card">
                            <span>Total Equipment Value</span>
                            <strong>
                                @equipmentSummary.TotalEquipmentValue.ToString("N2")
                            </strong>
                        </div>
                    </div>
                }
            </div>
        }
        @if (activeTab == "projects")
        {
            <div class="report-section">
                <div class="section-heading">
                    <div>
                        <h2>Project Report</h2>
                        <p>Current project portfolio statistics.</p>
                    </div>
                </div>
                @if (projectSummary is not null)
                {
                    <div class="stat-grid">
                        <div class="stat-card">
                            <span>Total Projects</span>
                            <strong>@projectSummary.TotalProjects</strong>
                        </div>
                        <div class="stat-card">
                            <span>Active Projects</span>
                            <strong>@projectSummary.ActiveProjects</strong>
                        </div>
                        <div class="stat-card">
                            <span>Inactive Projects</span>
                            <strong>@projectSummary.InactiveProjects</strong>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
@code {
    private string activeTab = "inventory";
    private bool isLoading = true;
    private string? errorMessage;
    private DateTime? fromDate;
    private DateTime? toDate;
    private InventorySummaryDto? inventorySummary;
    private List<LowStockItemDto> lowStockItems = new();
    private List<StockMovementDto> stockMovements = new();
    private List<StockTransactionReportDto> stockTransactions = new();
    private ProcurementSummaryDto? procurementSummary;
    private EquipmentSummaryDto? equipmentSummary;
    private ProjectSummaryDto? projectSummary;
    private string[] InventoryChartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> InventoryChartSeries = new();
    private string[] StockMovementChartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> StockMovementChartSeries = new();
    private string[] ProcurementChartLabels = Array.Empty<string>();
    private List<ChartSeries<double>> ProcurementChartSeries = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadReportsAsync();
    }
    private async Task LoadReportsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            if (fromDate.HasValue &&toDate.HasValue && fromDate.Value.Date > toDate.Value.Date)
            {
                errorMessage = "From date cannot be later than To date.";
                return;
            }
            inventorySummary =
                await Http.GetFromJsonAsync<InventorySummaryDto>("api/reports/inventory-summary");
            lowStockItems =
                await Http.GetFromJsonAsync<List<LowStockItemDto>>("api/reports/low-stock")  ?? new();
            var query = BuildDateQuery();
            stockMovements =
                await Http.GetFromJsonAsync<List<StockMovementDto>>($"api/reports/stock-movements{query}") ?? new();
            stockTransactions =
                await Http.GetFromJsonAsync<List<StockTransactionReportDto>>($"api/reports/stock-transactions{query}") ?? new();
            procurementSummary =await Http.GetFromJsonAsync<ProcurementSummaryDto>($"api/reports/procurement-summary{query}");
            equipmentSummary = await Http.GetFromJsonAsync<EquipmentSummaryDto>("api/reports/equipment-summary");
            projectSummary = await Http.GetFromJsonAsync<ProjectSummaryDto>("api/reports/project-summary");
            BuildCharts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load reports: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    private string BuildDateQuery()
    {
        var parameters = new List<string>();
        if (fromDate.HasValue)
        {
            parameters.Add($"fromDate={fromDate.Value:yyyy-MM-dd}");
        }
        if (toDate.HasValue)
        {
            parameters.Add($"toDate={toDate.Value:yyyy-MM-dd}");
        }
        return parameters.Count == 0 ? string.Empty : "?" + string.Join("&", parameters);
    }
    private async Task ClearFilters()
    {
        fromDate = null;
        toDate = null;
        await LoadReportsAsync();
    }
    private string GetTabClass(string tab)
    {
        return activeTab == tab ? "report-tab active" : "report-tab";
    }
    private string GetExportUrl(string format)
    {
        var query = BuildDateQuery();

        return $"api/reports/export/{format}{query}";
    }
    private void BuildCharts()
    {
        BuildInventoryChart();
        BuildStockMovementChart();
        BuildProcurementChart();
    }
    private void BuildInventoryChart()
    {
        if (inventorySummary is null ||
            inventorySummary.Categories.Count == 0)
        {
            InventoryChartLabels = Array.Empty<string>();
            InventoryChartSeries = new();
            return;
        }

        InventoryChartLabels = inventorySummary.Categories
            .Select(c => c.CategoryName)
            .ToArray();

        InventoryChartSeries =
        [
            new ChartSeries<double>
        {
            Name = "Inventory Value",
            Data = inventorySummary.Categories
                .Select(c => (double)c.TotalValue)
                .ToArray()
        }
        ];
    }
    private void BuildStockMovementChart()
    {
        if (stockMovements.Count == 0)
        {
            StockMovementChartLabels = Array.Empty<string>();
            StockMovementChartSeries = new();
            return;
        }

        StockMovementChartLabels = stockMovements
            .Select(x => x.Date.ToString("dd MMM"))
            .ToArray();

        StockMovementChartSeries =
        [
            new ChartSeries<double>
        {
            Name = "Stock In",
            Data = stockMovements
                .Select(x => (double)x.StockIn)
                .ToArray()
        },

        new ChartSeries<double>
        {
            Name = "Stock Out",
            Data = stockMovements
                .Select(x => (double)x.StockOut)
                .ToArray()
        },

        new ChartSeries<double>
        {
            Name = "Returns",
            Data = stockMovements
                .Select(x => (double)x.Returns)
                .ToArray()
        }
        ];
    }
    private void BuildProcurementChart()
    {
        if (procurementSummary is null ||
            procurementSummary.Suppliers.Count == 0)
        {
            ProcurementChartLabels = Array.Empty<string>();
            ProcurementChartSeries = new();
            return;
        }

        ProcurementChartLabels = procurementSummary.Suppliers
            .Select(x => x.SupplierName)
            .ToArray();

        ProcurementChartSeries =
        [
            new ChartSeries<double>
        {
            Name = "Purchase Value",
            Data = procurementSummary.Suppliers
                .Select(x => (double)x.TotalPurchaseValue)
                .ToArray()
        }
        ];
    }
}