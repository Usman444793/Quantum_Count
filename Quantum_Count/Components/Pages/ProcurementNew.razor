@page "/procurement/new"

@using Microsoft.AspNetCore.Authorization
@using Quantum_Count.Models
@using Quantum_Count.Services

@attribute [Authorize]

@inject InventoryService InventoryService
@inject NavigationManager Navigation

<PageTitle>New Purchase Order | Quantum Count</PageTitle>

<div class="procurement-form-page">

    <div class="page-header">

        <div>
            <h1>New Purchase Order</h1>
            <p>Create a purchase order for materials.</p>
        </div>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("/procurement"))">
            Back
        </MudButton>

    </div>

    <MudPaper Class="procurement-form-card" Elevation="1">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined"
                      Class="mb-4">
                @errorMessage
            </MudAlert>
        }

        <EditForm Model="@purchaseOrder"
                  OnValidSubmit="@CreatePurchaseOrder">

            <DataAnnotationsValidator />

            <div class="form-section">

                <h3>Purchase Order Information</h3>

                <div class="form-grid">

                    <MudTextField @bind-Value="purchaseOrder.PONumber"
                                  Label="PO Number"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="Unique purchase order number" />

                    <div class="native-form-field">
                        <label for="supplier">Supplier</label>

                        <select id="supplier"
                                class="native-select"
                                @bind="purchaseOrder.SupplierId">

                            <option value="0">Select Supplier</option>

                            @foreach (var supplier in suppliers)
                            {
                                <option value="@supplier.Id">
                                    @supplier.SupplierCode - @supplier.CompanyName
                                </option>
                            }

                        </select>

                        <ValidationMessage For="@(() => purchaseOrder.SupplierId)" />
                    </div>
                    <div class="native-form-field">
                        <label for="order-date">Order Date</label>

                        <input id="order-date"
                               type="date"
                               class="native-date-input"
                               @bind="orderDate" />

                        <ValidationMessage For="@(() => purchaseOrder.OrderDate)" />
                    </div>

                    <div class="native-form-field">
                        <label for="expected-delivery">Expected Delivery</label>

                        <input id="expected-delivery"
                               type="date"
                               class="native-date-input"
                               @bind="expectedDeliveryDate" />

                        <ValidationMessage For="@(() => purchaseOrder.ExpectedDeliveryDate)" />
                    </div>

                </div>

                <MudTextField @bind-Value="purchaseOrder.Notes"
                              Label="Notes"
                              Variant="Variant.Outlined"
                              Lines="4"
                              Class="mt-4" />

            </div>

            <div class="po-info-box">

                <MudIcon Icon="@Icons.Material.Filled.Info" />

                <div>
                    <strong>Purchase Order Status</strong>

                    <p>
                        New purchase orders are created as
                        <strong>Draft</strong>.
                        Items can be added after creation.
                    </p>
                </div>

            </div>

            <div class="form-actions">

                <MudButton Variant="Variant.Outlined"
                           OnClick="@(() => Navigation.NavigateTo("/procurement"))">
                    Cancel
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@isSaving"
                           StartIcon="@Icons.Material.Filled.Save">

                    @(isSaving ? "Creating..." : "Create Purchase Order")

                </MudButton>

            </div>

        </EditForm>

    </MudPaper>

</div>

@code {
    private List<Supplier> suppliers = new();
    private DateTime? orderDate = DateTime.Today;
    private bool isSaving;
    private bool isLoading;
    private string? errorMessage;
    private PurchaseOrder purchaseOrder = new()
    {
        OrderDate = DateTime.Today,
        Status = "Draft"
    };

    private DateTime? expectedDeliveryDate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            suppliers =
                await InventoryService.GetSuppliersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreatePurchaseOrder()
    {
        try
        {
            isSaving = true;
            errorMessage = null;

            purchaseOrder.OrderDate =
                orderDate ?? DateTime.Today;

            purchaseOrder.ExpectedDeliveryDate = expectedDeliveryDate;

            var result =
                await InventoryService.CreatePurchaseOrderAsync(
                    purchaseOrder);

            if (!result.success)
            {
                errorMessage = result.message;
                return;
            }

            Navigation.NavigateTo(
                $"/procurement/{result.purchaseOrder!.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}