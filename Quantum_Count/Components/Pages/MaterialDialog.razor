@page "/materials/new"
@page "/materials/edit/{Id:int}"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using Quantum_Count.Models
@using Quantum_Count.Services

@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>
    @(_isEdit ? "Edit Material" : "New Material") | Quantum Count
</PageTitle>

<div class="material-form-page">

    <div class="form-header">

        <div>

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Class="back-button"
                       Href="/materials">

                Back to Materials

            </MudButton>

            <h1>
                @(_isEdit ? "Edit Material" : "New Material")
            </h1>

            <p>
                @(_isEdit
                    ? "Update the material information and inventory levels."
                    : "Add a new material to your inventory.")
            </p>

        </div>

    </div>


    @if (_loading)
    {
        <div class="form-loading">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <span>Loading material...</span>

        </div>
    }
    else
    {
        <EditForm Model="_model"
                  OnValidSubmit="SaveAsync">

            <DataAnnotationsValidator />

            <div class="form-card">

                <div class="form-section">

                    <div class="section-title">

                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />

                        <div>
                            <h2>Basic Information</h2>
                            <p>Identify and describe the material.</p>
                        </div>

                    </div>


                    <div class="form-grid">

                        <MudTextField T="string"
                                      Label="Material Code"
                                      @bind-Value="_model.MaterialCode"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Material code is required."
                                      HelperText="Example: MAT-001" />

                        <MudTextField T="string"
                                      Label="Material Name"
                                      @bind-Value="_model.Name"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Material name is required." />

                        <div class="native-form-field">
                            <select id="material-category"
                                    class="native-select"
                                    @bind="_model.CategoryId">
                                <option value="0">Select a category</option>
                                @foreach (var category in _categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }
                            </select>
                            <ValidationMessage For="@(() => _model.CategoryId)" />
                        </div>
                        <MudTextField T="string"
                                      Label="Unit"
                                      @bind-Value="_model.Unit"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Unit is required."
                                      HelperText="Example: kg, pcs, meters" />

                    </div>


                    <MudTextField T="string"
                                  Label="Description"
                                  @bind-Value="_model.Description"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Class="description-field" />

                </div>


                <div class="form-divider"></div>


                <div class="form-section">

                    <div class="section-title">

                        <MudIcon Icon="@Icons.Material.Filled.BarChart" />

                        <div>
                            <h2>Inventory & Pricing</h2>
                            <p>Configure stock levels and material cost.</p>
                        </div>

                    </div>


                    <div class="form-grid">

                        <MudNumericField T="decimal"
                                         Label="Quantity"
                                         @bind-Value="_model.Quantity"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Required="true" />

                        <MudNumericField T="decimal"
                                         Label="Minimum Stock Level"
                                         @bind-Value="_model.MinimumStockLevel"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Required="true" />

                        <MudNumericField T="decimal"
                                         Label="Maximum Stock Level"
                                         @bind-Value="_model.MaximumStockLevel"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Required="true" />

                        <MudNumericField T="decimal"
                                         Label="Unit Price"
                                         @bind-Value="_model.UnitPrice"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Required="true"
                                         Adornment="Adornment.Start"
                                         AdornmentText="$" />

                    </div>

                </div>


                <div class="form-divider"></div>


                <div class="form-footer">

                    <MudButton Variant="Variant.Text"
                               Href="/materials"
                               Class="cancel-button">

                        Cancel

                    </MudButton>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Save"
                               Class="save-button"
                               Disabled="_saving">

                        @(_saving ? "Saving..." :
                            _isEdit ? "Save Changes" : "Create Material")

                    </MudButton>

                </div>

            </div>

        </EditForm>
    }

</div>


@code {

    [Parameter]
    public int? Id { get; set; }


    private Material _model = new();

    private List<InventoryCategory> _categories = [];

    private bool _loading = true;

    private bool _saving;

    private bool _isEdit =>
        Id.HasValue;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories =
                await InventoryService.GetCategoriesAsync();

            if (Id.HasValue)
            {
                var material =
                    await InventoryService.GetMaterialAsync(Id.Value);

                if (material == null)
                {
                    Snackbar.Add(
                        "Material not found.",
                        Severity.Error);

                    Navigation.NavigateTo("/materials");

                    return;
                }

                _model = material;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load material: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            if (_isEdit)
            {
                await InventoryService.UpdateMaterialAsync(_model);

                Snackbar.Add(
                    "Material updated successfully.",
                    Severity.Success);
            }
            else
            {
                await InventoryService.CreateMaterialAsync(_model);

                Snackbar.Add(
                    "Material created successfully.",
                    Severity.Success);
            }

            Navigation.NavigateTo("/materials");
        }
        catch
        {
            Snackbar.Add(
                "Unable to save material.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}