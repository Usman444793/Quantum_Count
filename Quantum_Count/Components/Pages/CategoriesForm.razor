@page "/categories/new"
@page "/categories/edit/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using Quantum_Count.Models
@using Quantum_Count.Services
@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
<PageTitle>
    @(_isEdit ? "Edit Category" : "New Category") | Quantum Count
</PageTitle>

<div class="category-form-page">

    <div class="form-header">

        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Class="back-button"
                   Href="/categories">

            Back to Categories

        </MudButton>

        <h1>
            @(_isEdit ? "Edit Category" : "New Category")
        </h1>

        <p>
            @(_isEdit
                ? "Update the category information."
                : "Create a category for materials and equipment.")
        </p>

    </div>


    @if (_loading)
    {
        <div class="form-loading">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <span>Loading category...</span>

        </div>
    }
    else
    {
        <EditForm Model="_model"
                  OnValidSubmit="SaveAsync">

            <DataAnnotationsValidator />

            <div class="form-card">

                <div class="section-title">

                    <div class="section-icon">

                        <MudIcon Icon="@Icons.Material.Filled.Category" />

                    </div>

                    <div>

                        <h2>Category Information</h2>

                        <p>
                            Define the name and description of this category.
                        </p>

                    </div>

                </div>


                <div class="form-fields">

                    <MudTextField T="string"
                                  Label="Category Name"
                                  @bind-Value="_model.Name"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Category name is required."
                                  Placeholder="Example: Electrical" />


                    <MudTextField T="string"
                                  Label="Description"
                                  @bind-Value="_model.Description"
                                  Variant="Variant.Outlined"
                                  Lines="5"
                                  Placeholder="Describe what this category is used for..." />

                </div>


                @if (_isEdit)
                {
                    <div class="info-box">

                        <MudIcon Icon="@Icons.Material.Filled.Info" />

                        <span>
                            Changes to this category will apply to existing
                            materials and equipment using it.
                        </span>

                    </div>
                }


                <div class="form-footer">

                    <MudButton Variant="Variant.Text"
                               Href="/categories"
                               Class="cancel-button">

                        Cancel

                    </MudButton>


                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Save"
                               Class="save-button"
                               Disabled="_saving">

                        @(_saving
                            ? "Saving..."
                            : _isEdit
                                ? "Save Changes"
                                : "Create Category")

                    </MudButton>

                </div>

            </div>

        </EditForm>
    }

</div>


@code {

    [Parameter]
    public int? Id { get; set; }


    private InventoryCategory _model = new();

    private bool _loading = true;

    private bool _saving;

    private bool _isEdit => Id.HasValue;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Id.HasValue)
            {
                var category =
                    await InventoryService.GetCategoryAsync(Id.Value);

                if (category == null)
                {
                    Snackbar.Add(
                        "Category not found.",
                        Severity.Error);

                    Navigation.NavigateTo("/categories");

                    return;
                }

                _model = category;
            }
        }
        catch
        {
            Snackbar.Add(
                "Unable to load category.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            if (_isEdit)
            {
                var result =
                    await InventoryService
                        .UpdateCategoryAsync(_model);

                if (result == null)
                {
                    Snackbar.Add(
                        "Category not found.",
                        Severity.Error);

                    return;
                }

                Snackbar.Add(
                    "Category updated successfully.",
                    Severity.Success);
            }
            else
            {
                await InventoryService
                    .CreateCategoryAsync(_model);

                Snackbar.Add(
                    "Category created successfully.",
                    Severity.Success);
            }

            Navigation.NavigateTo("/categories");
        }
        catch
        {
            Snackbar.Add(
                "Unable to save category.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}