@page "/equipment/new"
@page "/equipment/edit/{Id:int}"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using Quantum_Count.Models
@using Quantum_Count.Services

@inject InventoryService InventoryService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>
    @(_isEdit ? "Edit Equipment" : "New Equipment") | Quantum Count
</PageTitle>

<div class="equipment-form-page">

    <div class="form-header">

        <div>

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Class="back-button"
                       Href="/equipment">

                Back to Equipment

            </MudButton>

            <h1>
                @(_isEdit ? "Edit Equipment" : "New Equipment")
            </h1>

            <p>
                @(_isEdit
                    ? "Update equipment information and operational status."
                    : "Register a new equipment asset.")
            </p>

        </div>

    </div>


    @if (_loading)
    {
        <div class="form-loading">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <span>Loading equipment...</span>

        </div>
    }
    else
    {
        <EditForm Model="_model"
                  OnValidSubmit="SaveAsync">

            <DataAnnotationsValidator />

            <div class="form-card">

                <div class="form-section">

                    <div class="section-title">

                        <MudIcon Icon="@Icons.Material.Filled.Build" />

                        <div>
                            <h2>Equipment Information</h2>
                            <p>Identify and classify the equipment.</p>
                        </div>

                    </div>


                    <div class="form-grid">

                        <MudTextField T="string"
                                      Label="Equipment Code"
                                      @bind-Value="_model.EquipmentCode"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      HelperText="Example: EQ-001" />

                        <MudTextField T="string"
                                      Label="Equipment Name"
                                      @bind-Value="_model.Name"
                                      Variant="Variant.Outlined"
                                      Required="true" />

                        <MudSelect T="int"
                                   Label="Category"
                                   @bind-Value="_model.CategoryId"
                                   Variant="Variant.Outlined"
                                   Required="true">

                            @foreach (var category in _categories)
                            {
                                <MudSelectItem T="int"
                                               Value="@category.Id">

                                    @category.Name

                                </MudSelectItem>
                            }

                        </MudSelect>

                        <MudSelect T="string"
                                   Label="Status"
                                   @bind-Value="_model.Status"
                                   Variant="Variant.Outlined">

                            <MudSelectItem Value="@("Available")">
                                Available
                            </MudSelectItem>

                            <MudSelectItem Value="@("In Use")">
                                In Use
                            </MudSelectItem>

                            <MudSelectItem Value="@("Maintenance")">
                                Maintenance
                            </MudSelectItem>

                            <MudSelectItem Value="@("Damaged")">
                                Damaged
                            </MudSelectItem>

                            <MudSelectItem Value="@("Retired")">
                                Retired
                            </MudSelectItem>

                        </MudSelect>

                    </div>

                </div>


                <div class="form-divider"></div>


                <div class="form-section">

                    <div class="section-title">

                        <MudIcon Icon="@Icons.Material.Filled.Fingerprint" />

                        <div>
                            <h2>Asset Details</h2>
                            <p>Manufacturer and purchase information.</p>
                        </div>

                    </div>


                    <div class="form-grid">

                        <MudTextField T="string"
                                      Label="Serial Number"
                                      @bind-Value="_model.SerialNumber"
                                      Variant="Variant.Outlined" />

                        <MudTextField T="string"
                                      Label="Brand"
                                      @bind-Value="_model.Brand"
                                      Variant="Variant.Outlined" />

                        <MudTextField T="string"
                                      Label="Model"
                                      @bind-Value="_model.Model"
                                      Variant="Variant.Outlined" />

                        <MudNumericField T="decimal"
                                         Label="Purchase Price"
                                         @bind-Value="_model.PurchasePrice"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Adornment="Adornment.Start"
                                         AdornmentText="$" />

                        <MudDatePicker Label="Purchase Date"
                                       @bind-Date="_model.PurchaseDate"
                                       Variant="Variant.Outlined" />

                    </div>


                    <MudTextField T="string"
                                  Label="Description"
                                  @bind-Value="_model.Description"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Class="description-field" />

                </div>


                <div class="form-divider"></div>


                <div class="form-footer">

                    <MudButton Variant="Variant.Text"
                               Href="/equipment"
                               Class="cancel-button">

                        Cancel

                    </MudButton>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Save"
                               Class="save-button"
                               Disabled="_saving">

                        @(_saving ? "Saving..." :
                            _isEdit ? "Save Changes" : "Create Equipment")

                    </MudButton>

                </div>

            </div>

        </EditForm>
    }

</div>


@code {

    [Parameter]
    public int? Id { get; set; }


    private Equipment _model = new()
    {
        Status = "Available"
    };

    private List<InventoryCategory> _categories = [];

    private bool _loading = true;

    private bool _saving;

    private bool _isEdit =>
        Id.HasValue;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories =
                await InventoryService.GetCategoriesAsync();

            if (Id.HasValue)
            {
                var equipment =
                    await InventoryService.GetEquipmentAsync(Id.Value);

                if (equipment == null)
                {
                    Snackbar.Add(
                        "Equipment not found.",
                        Severity.Error);

                    Navigation.NavigateTo("/equipment");

                    return;
                }

                _model = equipment;
            }
        }
        catch
        {
            Snackbar.Add(
                "Unable to load equipment.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            if (_isEdit)
            {
                await InventoryService.UpdateEquipmentAsync(_model);

                Snackbar.Add(
                    "Equipment updated successfully.",
                    Severity.Success);
            }
            else
            {
                await InventoryService.CreateEquipmentAsync(_model);

                Snackbar.Add(
                    "Equipment created successfully.",
                    Severity.Success);
            }

            Navigation.NavigateTo("/equipment");
        }
        catch
        {
            Snackbar.Add(
                "Unable to save equipment.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}