@page "/procurement/edit/{Id:int}"

@using Microsoft.AspNetCore.Authorization
@using Quantum_Count.Models
@using Quantum_Count.Services

@attribute [Authorize]

@inject InventoryService InventoryService
@inject NavigationManager Navigation

<PageTitle>Edit Purchase Order | Quantum Count</PageTitle>

<div class="procurement-form-page">

    <div class="page-header">

        <div>
            <h1>Edit Purchase Order</h1>
            <p>Update purchase order information.</p>
        </div>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() =>
                                   Navigation.NavigateTo($"/procurement/{Id}"))">
            Back
        </MudButton>

    </div>

    @if (isLoading)
    {
        <div class="procurement-loading">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

            <MudText>
                Loading purchase order...
            </MudText>

        </div>
    }
    else if (purchaseOrder == null)
    {
        <MudAlert Severity="Severity.Warning"
                  Variant="Variant.Outlined">

            Purchase order not found.

        </MudAlert>
    }
    else if (purchaseOrder.Status != "Draft")
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Outlined">

            Only Draft purchase orders can be edited.

        </MudAlert>
    }
    else
    {
        <MudPaper Class="procurement-form-card" Elevation="1">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined"
                          Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            <EditForm Model="@purchaseOrder"
                      OnValidSubmit="@UpdatePurchaseOrder">

                <DataAnnotationsValidator />

                <div class="form-section">

                    <h3>Purchase Order Information</h3>

                    <div class="form-grid">

                        <MudTextField @bind-Value="purchaseOrder.PONumber"
                                      Label="PO Number"
                                      Variant="Variant.Outlined"
                                      Required="true" />

                        <div class="native-form-field">
                            <label for="supplier">Supplier</label>

                            <select id="supplier"
                                    class="native-select"
                                    @bind="purchaseOrder.SupplierId">

                                <option value="0">Select Supplier</option>

                                @foreach (var supplier in suppliers)
                                {
                                    <option value="@supplier.Id">
                                        @supplier.SupplierCode - @supplier.CompanyName
                                    </option>
                                }

                            </select>

                            <ValidationMessage For="@(() => purchaseOrder.SupplierId)" />
                        </div>

                        <div class="native-form-field">
                            <label for="order-date">Order Date</label>

                            <input id="order-date"
                                   type="date"
                                   class="native-date-input"
                                   @bind="orderDate" />

                            <ValidationMessage For="@(() => purchaseOrder.OrderDate)" />
                        </div>

                        <div class="native-form-field">
                            <label for="expected-delivery">Expected Delivery</label>

                            <input id="expected-delivery"
                                   type="date"
                                   class="native-date-input"
                                   @bind="expectedDeliveryDate" />

                            <ValidationMessage For="@(() => purchaseOrder.ExpectedDeliveryDate)" />
                        </div>

                    </div>

                    <MudTextField @bind-Value="purchaseOrder.Notes"
                                  Label="Notes"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Class="mt-4" />

                </div>

                <div class="form-actions">

                    <MudButton Variant="Variant.Outlined"
                               OnClick="@(() =>
                                                           Navigation.NavigateTo($"/procurement/{Id}"))">
                        Cancel
                    </MudButton>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isSaving"
                               StartIcon="@Icons.Material.Filled.Save">

                        @(isSaving ? "Updating..." : "Update Purchase Order")

                    </MudButton>

                </div>

            </EditForm>

        </MudPaper>
    }

</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private PurchaseOrder? purchaseOrder;

    private List<Supplier> suppliers = new();

    private DateTime? orderDate;
    private DateTime? expectedDeliveryDate;

    private bool isLoading = true;
    private bool isSaving;

    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            purchaseOrder = await InventoryService.GetPurchaseOrderAsync(Id);
            suppliers = await InventoryService.GetSuppliersAsync();

            if (purchaseOrder != null)
            {
                orderDate = purchaseOrder.OrderDate;
                expectedDeliveryDate = purchaseOrder.ExpectedDeliveryDate;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdatePurchaseOrder()
    {
        if (purchaseOrder == null)
            return;

        try
        {
            isSaving = true;
            errorMessage = null;

            purchaseOrder.OrderDate = orderDate ?? DateTime.Today;
            purchaseOrder.ExpectedDeliveryDate = expectedDeliveryDate;

            var result = await InventoryService.UpdatePurchaseOrderAsync(purchaseOrder);

            if (!result.success)
            {
                errorMessage = result.message;
                return;
            }

            Navigation.NavigateTo($"/procurement/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}