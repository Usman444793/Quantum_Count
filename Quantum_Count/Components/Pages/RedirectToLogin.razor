@inject NavigationManager Navigation

<div class="redirect-login">

    <div class="redirect-spinner"></div>

    <p>Redirecting to sign in...</p>

</div>

@code {

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
    }
}