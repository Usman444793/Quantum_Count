@page "/materials/{id:int}/transactions/new"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Quantum_Count.Models
@using Quantum_Count.Services
@using Microsoft.AspNetCore.Components.Forms
@inject InventoryService InventoryService
@inject NavigationManager Navigation
<PageTitle>New Stock Transaction - Quantum Count</PageTitle>
<div class="transaction-page">
    <div class="transaction-header">
        <h1>New Stock Transaction</h1>
        <p>Record a stock movement for this material</p>
    </div>
    <button class="back-button" @onclick="GoBack">← Back</button>
</div>
@if (isLoading)
{
    <div class="loading-state">
        Loading Material...
    </div>
}
else if (material == null)
{
    <div class="error-state">
    Material Not Found.
</div>
}
else
{
<div class="material-summary">
    <div>
    <span class="summary-label">Material</span>
    <strong>@material.Name</strong>
    </div>
    <div>
    <span class="summary-label">Code</span>
    <strong>@material.MaterialCode</strong>
    </div>
    <div>
    <span class="summary-label">Current Stock</span>
    <strong>@material.Quantity @material.Unit</strong>
    </div>
    <div>
    <span class="summary-label">Minimum Level</span>
    <strong>@material.MinimumStockLevel @material.Unit</strong>
    </div>
</div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">
            @errorMessage
        </div>
    }
    <EditForm Model="@transactions" OnValidSubmit="CreateTransaction">
        <DataAnnotationsValidator />
        <div class="form-card">
            <div class="form-title">
                <h2>Stock Movement</h2>
                <p>Enter the details of this Inventory Transaction</p>
            </div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Material</label>
                    <input class="form-input" value="@($"{material.MaterialCode} - {material.Name}")" readonly />
                </div>
                <div class="form-group">
                    <label for="transactionType">Transaction type</label>
                    <select id="transactionType" class="form-input" @bind="transactions.TransactionType">
                        <option value="">Select transaction type</option>
                        <option value="Stock In">Stock In</option>
                        <option value="Stock Out">Stock Out</option>
                        <option value="Return">Return</option>
                        <option value="Damaged">Damaged</option>
                        <option value="Adjustment">Adjustment</option>
                    </select>
                    <ValidationMessage For="@(() => transactions.TransactionType)" />
                </div>
                <div class="form-group">
                    <label for="quantity">Quantity</label>
                    <input id="quantity" type="number" step="0.01" min="0.01" class="form-input" @bind="transactions.Quantity" />
                    <ValidationMessage For="@(() => transactions.Quantity)" />
                </div>
                <div class="form-group">
                    <label for="reference">Reference</label>
                    <input id="reference" class="form-input" placeholder="PO number, invoice, etc." @bind="transactions.Reference" />
                </div>
                <div class="form-group full-width">
                    <label for="notes"> Notes </label>
                    <textarea id="notes" class="form-input notes-input" rows="4" placeholder="Additional information..." @bind="transactions.Notes">
                    </textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="cancel-button" @onclick="GoBack">Cancel</button>
                <button type="submit" class="save-button" disabled="@isSaving">
                    @(isSaving ? "Processing..." : "Create Transaction")
                </button>
            </div>
        </div>
    </EditForm>
}
@code{
    [Parameter]
    public int Id { get; set; }
    private Material? material;
    private InventoryTransactions transactions = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        material = await InventoryService.GetMaterialAsync(Id);
        if (material != null)
        {
            transactions.MaterialId = material.Id;
        }
        isLoading = false;
    }
    private async Task CreateTransaction()
    {
        if (material == null)
        {
            return;
        }
        errorMessage = string.Empty;
        isSaving = true;
        try
        {
            transactions.MaterialId = material.Id;
            var result = await InventoryService.CreateTransactionAsync(transactions);
            if (!result.success)
            {
                errorMessage = result.message;
                return;
            }
            Navigation.NavigateTo($"/materials/{material.Id}/transactions");
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to create transaction.";
            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
    private void GoBack()
    {
        Navigation.NavigateTo($"/materials/{Id}/transactions");
    }
}