@page "/login"
@layout PublicLayout
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Login - Quantum Count</PageTitle>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">QC</div>
        <h1>Welcome Back</h1>
        <p class="auth-subtitle">Sign in to Quantum Count</p>
        <form method="post" action="/api/auth/login-form" class="login-form">
            <AntiforgeryToken />
            <div class="form-group">
                <label for="email">Email Address</label>
                <input id="email" name="Email" type="email" class="form-input" placeholder="Enter your email" required />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input id="password" name="Password" type="password" class="form-input" placeholder="Enter your password" required />
            </div>
            <button type="submit" class="auth-button">Sign In</button>
        </form>
        @if (showError)
        {
            <div class="error-message">@errorText</div>
        }
        <div class="auth-footer">
            <span>Don't have an account?</span>
            <a href="/register">Create account</a>
        </div>
    </div>
</div>
@code {
    private bool showError;
    private string errorText = string.Empty;
    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var val))
        {
            showError = true;
            errorText = val == "invalid" ? "Invalid email or password." : "Authentication error.";
        }
    }
}