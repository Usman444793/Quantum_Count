@page "/"
@layout PublicLayout
<PageTitle>Quantum Count - Inventory Management</PageTitle>
<div class="landing-page">
    <header class="landing-header">
        <div class="brand">
            <div class="brand-icon">QC</div>
            <div>
                <div class="brand-name">Quantum Count</div>
                <div class="brand-subtitle">Inventory Management</div>
            </div>
        </div>
        <nav class="landing-nav">
            <a href="#features">Features</a>
            <a href="#about">About</a>
            <a href="#support">Support</a>
            <a href="/login" class="login-link">Login</a>
            <a href="/register" class="signup-button">Sign Up</a>
        </nav>
    </header>
    <main class="hero-section">
        <div class="hero-content">
            <span class="hero-badge"> Modern Inventory Management</span>
            <h1>Manage your inventory.
            <br />
            <span>Make better decisions.</span>
            </h1>
            <p> Quantum Count gives your organization one place
                to manage materials, projects, equipment,
                procurement and inventory analytics.</p>
            <div class="hero-actions">
                <a href="/register" class="primary-button"> Get Started </a>
                <a href="/login" class="secondary-button"> Sign In </a>
            </div>
        </div>
    </main>
    <section id="features" class="features-section">
        <div class="section-heading">
            <span>FEATURES</span>
            <h2> Everything you need to manage inventory</h2>
            <p>
                A centralized platform designed for
                modern inventory operations.
            </p>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Inventory2"/></div>
                <h3>Inventory</h3>
                <p>
                    Track materials, quantities,
                    stock levels and availability.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Assignment"/></div>
                <h3>Projects</h3>
                <p>
                    Connect materials and resources
                    with organizational projects.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.BusinessCenter"/></div>
                <h3>Assets</h3>
                <p>
                    Manage equipment and organizational
                    assets from one place.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.BarChart"/></div>
                <h3>Analytics</h3>
                <p>
                    Understand inventory performance
                    through meaningful reports.
                </p>
            </div>
        </div>
    </section>
    <section id="about" class="features-section">
        <div class="section-heading">
            <span>ABOUT THE PROJECT</span>
            <h2>Architected for Modern Enterprise Needs</h2>
            <p>
                Quantum Count was built as a high-performance inventory management system
                designed to simplify stock tracking, project resource allocations, and real-time asset analytics.
            </p>
        </div>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Code" /></div>
                <h3>Core Architecture</h3>
                <p>
                    Engineered with ASP.NET Core & Blazor Interactive Server for real-time reactivity, paired with Entity Framework Core and SQL Server.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Security" /></div>
                <h3>Identity & Security</h3>
                <p>
                    Integrated with ASP.NET Core Identity and JWT authentication, offering secure role-based access control and system audit enforcement.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Palette" /></div>
                <h3>UI & State Management</h3>
                <p>
                    Leverages MudBlazor alongside custom CSS themes (Light/Dark mode) with reactive state broadcasting via scoped application services.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></div>
                <h3>Smart Capabilities</h3>
                <p>
                    Features AI-assisted analytics orchestration via Google Gemini API integration for automated inventory summaries and operational insights.
                </p>
            </div>
        </div>
    </section>
    <section id="support" class="features-section">
        <div class="section-heading">
            <span>DEVELOPER & SUPPORT</span>
            <h2>Get in Touch & System Support</h2>
            <p>
                Developed and maintained as a showcase enterprise solution. Have questions, feedback, or need technical assistance?
            </p>
        </div>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Person" /></div>
                <h3>About the Lead Developer</h3>
                <p>
                    Built with precision to showcase full-stack C# .NET skills, modern SPA architectural patterns, and clean UX design principles.
                </p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Code" /></div>
                <h3>Connect & Follow</h3>
                <p>
                    Check out the source code, star the project, or connect with me professionally across developer networks.
                </p>
                <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
                    <a href="https://github.com/Usman444793" target="_blank" class="login-link" style="padding: 6px 12px; font-size: 12px;">GitHub</a>
                    <a href="https://linkedin.com/in/usman-a-46aa66329" target="_blank" class="signup-button" style="padding: 6px 12px; font-size: 12px;">LinkedIn</a>
                </div>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.ContactSupport" /></div>
                <h3>Technical Support</h3>
                <p>
                    Need assistance setting up database connection strings or environment migrations? Reach out via direct support channel.
                </p>
                <div style="margin-top: 12px;">
                    <a href="mailto:ua655128@gmail.com" class="signup-button" style="padding: 6px 12px; font-size: 13px;">Contact Developer</a>
                </div>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><MudIcon Icon="@Icons.Material.Filled.Description" /></div>
                <h3>Documentation & Setup</h3>
                <p>
                    Complete API documentation, database schemas, and configuration setup guidelines are included within the project repository.
                </p>
            </div>
        </div>
    </section>
    <footer class="public-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <div class="brand-icon small">
                    QC
                </div>
                <div>
                    <strong>Quantum Count</strong>
                    <span>Smart Inventory Management</span>
                </div>
            </div>
            <div class="footer-links">
                <a href="/">Home</a>
                <a href="#features">Features</a>
                <a href="#about">About</a>
                <NavLink href="/login">Sign In</NavLink>
            </div>
            <div class="copyright">
                © @DateTime.Now.Year Quantum Count. All rights reserved.
            </div>
        </div>
    </footer>
</div>