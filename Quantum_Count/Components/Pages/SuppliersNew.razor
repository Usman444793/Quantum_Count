@page "/suppliers/new"
@using Microsoft.AspNetCore.Authorization
@using Quantum_Count.Models
@using Quantum_Count.Services
@attribute [Authorize]
@inject InventoryService InventoryService
@inject NavigationManager Navigation
<PageTitle>New Supplier | Quantum Count</PageTitle>
<div class="supplier-form-page">
    <div class="page-header">
        <div>
            <h1>New Supplier</h1>
            <p>Add a new supplier to your procurement system.</p>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("/suppliers"))">
            Back
        </MudButton>
    </div>
    <MudPaper Class="supplier-form-card" Elevation="1">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Outlined"
                      Class="mb-4">
                @errorMessage
            </MudAlert>
        }

        <EditForm Model="@supplier" OnValidSubmit="@CreateSupplier">

            <DataAnnotationsValidator />

            <div class="form-section">

                <h3>Supplier Information</h3>

                <div class="form-grid">

                    <MudTextField @bind-Value="supplier.SupplierCode"
                                  Label="Supplier Code"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="Unique supplier identifier" />

                    <MudTextField @bind-Value="supplier.CompanyName"
                                  Label="Company Name"
                                  Variant="Variant.Outlined"
                                  Required="true" />

                    <MudTextField @bind-Value="supplier.ContactPerson"
                                  Label="Contact Person"
                                  Variant="Variant.Outlined" />

                    <MudTextField @bind-Value="supplier.Phone"
                                  Label="Phone"
                                  Variant="Variant.Outlined" />

                    <MudTextField @bind-Value="supplier.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email" />

                    <MudTextField @bind-Value="supplier.TaxNumber"
                                  Label="Tax Number"
                                  Variant="Variant.Outlined" />

                </div>

                <MudTextField @bind-Value="supplier.Address"
                              Label="Address"
                              Variant="Variant.Outlined"
                              Lines="3"
                              Class="mt-4" />

            </div>

            <div class="form-section">

                <h3>Status</h3>

                <MudSwitch @bind-Value="supplier.IsActive"
                           Color="Color.Primary">
                    Active Supplier
                </MudSwitch>
            </div>
            <div class="form-actions">

                <MudButton Variant="Variant.Outlined"
                           OnClick="@(() => Navigation.NavigateTo("/suppliers"))">
                    Cancel
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@isSaving"
                           StartIcon="@Icons.Material.Filled.Save">
                    @(isSaving ? "Saving..." : "Save Supplier")
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</div>
@code {
    private Supplier supplier = new();
    private bool isSaving;
    private string? errorMessage;
    private async Task CreateSupplier()
    {
        try
        {
            isSaving = true;
            errorMessage = null;
            var result = await InventoryService.CreateSupplierAsync(supplier);
            if (!result.success)
            {
                errorMessage = result.message;
                return;
            }
            Navigation.NavigateTo("/suppliers");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}