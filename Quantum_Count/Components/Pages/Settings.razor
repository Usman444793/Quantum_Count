@page "/settings"
@using Quantum_Count.Models
@using Quantum_Count.Services
@inject SettingsService SettingsService

<div class="settings-page">
    <div class="settings-header">
        <div class="page-breadcrumb">
            SYSTEM <span>/</span> SETTINGS
        </div>
        <h1>Application Settings</h1>
        <p>Manage system preferences and display theme settings.</p>
    </div>

    @if (_isLoading)
    {
        <div class="settings-loading">
            <div class="spinner"></div>
            <p>Loading settings...</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="settings-alert success" style="background: rgba(0, 201, 148, 0.1); border: 1px solid rgba(0, 201, 148, 0.3); color: #00c994; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
                @_successMessage
            </div>
        }

        <EditForm Model="_settings" OnValidSubmit="SaveSettingsAsync">
            <div class="settings-actions">
                <button type="submit" class="qc-btn-secondary" style="background: var(--qc-primary, #009b72); color: white; padding: 10px 20px; border-radius: 8px; border: none; cursor: pointer;">
                    @(_isSaving ? "Saving Configuration..." : "Save Settings")
                </button>
            </div>

            <div class="settings-grid">
                <!-- Organization Profile -->
                <div class="settings-card">
                    <div class="settings-card-header">
                        <div class="settings-icon">🏢</div>
                        <div>
                            <h2>Organization Identity</h2>
                            <p>Set your organization profile name.</p>
                        </div>
                    </div>
                    <div class="settings-form">
                        <div class="form-group">
                            <label>Organization Name</label>
                            <input type="text" @bind="_settings.OrganizationName" class="form-control" required />
                        </div>
                    </div>
                </div>

                <!-- Interface Theme Switcher -->
                <div class="settings-card">
                    <div class="settings-card-header">
                        <div class="settings-icon palette">🎨</div>
                        <div>
                            <h2>Appearance & Display</h2>
                            <p>Select your preferred visual application theme.</p>
                        </div>
                    </div>

                    <div class="theme-cards">
                        <div class="theme-card @(_settings.Theme == "Dark" ? "selected" : "")" @onclick='() => SetTheme("Dark")'>
                            <div class="theme-preview dark-preview">
                                <div class="preview-sidebar"></div>
                                <div class="preview-content">
                                    <div class="preview-bar"></div>
                                    <div class="preview-bar short"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <span class="theme-dot @(_settings.Theme == "Dark" ? "active" : "")"></span> Dark Theme
                            </div>
                        </div>

                        <div class="theme-card @(_settings.Theme == "Light" ? "selected" : "")" @onclick='() => SetTheme("Light")'>
                            <div class="theme-preview light-preview">
                                <div class="preview-sidebar"></div>
                                <div class="preview-content">
                                    <div class="preview-bar"></div>
                                    <div class="preview-bar short"></div>
                                </div>
                            </div>
                            <div class="theme-label">
                                <span class="theme-dot @(_settings.Theme == "Light" ? "active" : "")"></span> Light Theme
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Inventory Controls -->
                <div class="settings-card">
                    <div class="settings-card-header">
                        <div class="settings-icon inventory">📦</div>
                        <div>
                            <h2>Inventory System Rules</h2>
                            <p>Configure stock warnings and material transfer parameters.</p>
                        </div>
                    </div>
                    <div class="settings-options">
                        <div class="setting-option">
                            <div>
                                <strong>Enable Low Stock System Alerts</strong>
                                <span>Highlight critical inventory shortages across user dashboards.</span>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" @bind="_settings.LowStockAlerts" />
                                <span class="toggle-track"><span class="toggle-thumb"></span></span>
                            </label>
                        </div>
                        <div class="setting-option">
                            <div>
                                <strong>Allow Negative Stock Operations</strong>
                                <span>Permit stock deductions below zero balance during material transfers.</span>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" @bind="_settings.AllowNegativeStock" />
                                <span class="toggle-track"><span class="toggle-thumb"></span></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    private ApplicationSettings _settings = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetSettingsAsync();
        _isLoading = false;
    }

    private void SetTheme(string theme)
    {
        _settings.Theme = theme;
    }

    private async Task SaveSettingsAsync()
    {
        _isSaving = true;
        _successMessage = null;

        var result = await SettingsService.UpdateSettingsAsync(_settings);
        if (result.success)
        {
            _successMessage = result.message;
        }

        _isSaving = false;
    }
}