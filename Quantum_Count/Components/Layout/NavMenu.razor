@using Microsoft.AspNetCore.Components.Routing
<nav class="qc-nav-menu">
    @if (Matches("dashboard"))
    {
        <NavLink class="qc-nav-link" href="/dashboard" Match="NavLinkMatch.All" title="Dashboard">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Dashboard</span>
        </NavLink>
    }
    @if (Matches("materials inventory"))
    {
        <NavLink class="qc-nav-link" href="/materials" Match="NavLinkMatch.Prefix" title="Materials & Inventory">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Materials</span>
        </NavLink>
    }
    @if (Matches("equipment assets"))
    {
        <NavLink class="qc-nav-link" href="/equipment" Match="NavLinkMatch.Prefix" title="Equipment & Assets">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.Construction" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Equipment</span>
        </NavLink>
    }
    @if (Matches("categories"))
    {
        <NavLink class="qc-nav-link" href="/categories" Match="NavLinkMatch.Prefix" title="Categories">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Categories</span>
        </NavLink>
    }
    @if (Matches("projects"))
    {
        <NavLink class="qc-nav-link" href="/projects" Match="NavLinkMatch.Prefix" title="Projects">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Projects</span>
        </NavLink>
    }
    @if (Matches("procurement purchase orders"))
    {
        <NavLink class="qc-nav-link" href="/procurement" Match="NavLinkMatch.Prefix" title="Purchase Orders">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Purchase Orders</span>
        </NavLink>
    }
    @if (Matches("suppliers vendors"))
    {
        <NavLink class="qc-nav-link" href="/suppliers" Match="NavLinkMatch.Prefix" title="Suppliers">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Suppliers</span>
        </NavLink>
    }
    @if (Matches("reports analytics"))
    {
        <NavLink class="qc-nav-link" href="/reports" Match="NavLinkMatch.Prefix" title="Reports & Analytics">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Reports</span>
        </NavLink>
    }
    @if (Matches("staff roles users"))
    {
        <NavLink class="qc-nav-link" href="/staff" Match="NavLinkMatch.Prefix" title="Staff & Roles">
            <div class="qc-nav-icon-badge">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
            </div>
            <span class="qc-nav-label">&nbsp;Staff & Roles</span>
        </NavLink>
    }
</nav>
@code {
    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    private bool Matches(string keywords)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
            return true;

        return keywords.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
    }
}