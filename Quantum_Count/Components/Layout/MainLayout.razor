@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using Quantum_Count.Models
@using Quantum_Count.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SettingsService SettingsService
@inject Quantum_Count.Services.InventoryAiOrchestrator Orchestrator
@inject IJSRuntime JS
<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="quantum-shell @(_isDarkTheme ? "theme-dark" : "theme-light")" @onclick="CloseAccountMenu">
    <!-- TOP APPBAR -->
    <header class="quantum-topbar">
        <div class="topbar-left">
            <button type="button" class="mobile-toggle-btn" @onclick="ToggleMobileDrawer" aria-label="Toggle navigation menu">
                <MudIcon Icon="@Icons.Material.Filled.Menu" />
            </button>
            <a class="topbar-brand" href="/dashboard">
                <div class="topbar-logo">QC</div>
                <div class="topbar-title-group">
                    <span class="topbar-name">Quantum Count</span>
                    <span class="topbar-subtitle">Inventory Management</span>
                </div>
            </a>
        </div>

        <div class="topbar-right">
            <!-- Theme Mode Switcher -->
            <button type="button" class="theme-toggle-btn" @onclick="ToggleTheme" title="@(_isDarkTheme ? "Switch to Light Mode" : "Switch to Dark Mode")">
                <MudIcon Icon="@(_isDarkTheme ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode)" />
            </button>

            <!-- Account Menu -->
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="account-menu-wrapper">
                        <button type="button" class="avatar-button" @onclick:stopPropagation="true" @onclick="ToggleAccountMenu" aria-expanded="@(accountMenuOpen)">
                            <div class="avatar-circle">@GetInitial(authState.User)</div>
                        </button>
                        <div class="account-popover @(accountMenuOpen ? "visible" : "hidden")" @onclick:stopPropagation="true" role="menu">
                            <div class="user-menu-header">
                                <strong>@GetUserName(authState.User)</strong>
                                <div class="user-email">@GetUserEmail(authState.User)</div>
                            </div>
                            <div class="popover-divider"></div>
                            <a class="popover-item" href="/dashboard" @onclick="CloseAccountMenu"> Dashboard</a>
                            <a class="popover-item" href="/materials" @onclick="CloseAccountMenu"> Materials</a>
                            <a class="popover-item" href="/equipment" @onclick="CloseAccountMenu"> Equipment</a>
                            <a class="popover-item" href="/categories" @onclick="CloseAccountMenu"> Categories</a>
                            <a class="popover-item" href="/projects" @onclick="CloseAccountMenu"> Projects</a>
                            <a class="popover-item" href="/procurement" @onclick="CloseAccountMenu"> Procurement</a>
                            <a class="popover-item" href="/suppliers" @onclick="CloseAccountMenu"> Suppliers</a>
                            <a class="popover-item" href="/reports" @onclick="CloseAccountMenu"> Reports & Analytics</a>
                            <a class="popover-item" href="/staff" @onclick="CloseAccountMenu"> Staff & Roles</a>
                            <a class="popover-item" href="/settings" @onclick="CloseAccountMenu"> Settings</a>
                            <div class="popover-divider"></div>
                            <form method="post" action="/api/auth/logout" style="margin: 0; padding: 0;">
                                <AntiforgeryToken />
                                <button type="submit" class="popover-item logout-button">
                                    <span>↪</span>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="qc-btn-primary" style="text-decoration: none;">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>
    <div class="quantum-layout-body">
        @if (_mobileDrawerOpen)
        {
            <div class="sidebar-backdrop" @onclick="CloseMobileDrawer"></div>
        }
        <aside class="quantum-sidebar @(_mobileDrawerOpen ? "mobile-open" : "")">
            <div class="sidebar-header">
                <div class="sidebar-brand-icon">QC</div>
                <div class="sidebar-brand-text">
                    <span class="brand-main">Quantum Count</span>
                    <span class="brand-sub">Operations</span>
                </div>
            </div>
            <div class="sidebar-search">
                <div class="sidebar-search-box">
                    <span class="sidebar-search-icon">⌕</span>
                    <input class="sidebar-search-input" placeholder="Search menu..." @bind="_searchText" @bind:event="oninput" />
                </div>
            </div>
            <div class="sidebar-nav-container">
                <NavMenu SearchText="@_searchText" />
            </div>

            <div class="sidebar-footer">
                <NavLink class="qc-nav-link" href="/settings" Match="NavLinkMatch.Prefix" title="Settings">
                    <div class="qc-nav-icon-badge">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                    </div>
                    <span class="qc-nav-label">&nbsp;Settings</span>
                </NavLink>
            </div>
        </aside>
        <main class="quantum-content">
            @Body
        </main>
    </div>
</div>
<!-- QUANTUM AI ASSISTANT -->
<div class="quantum-ai">
    @if (_aiOpen)
    {
        <div class="ai-window">
            <div class="ai-header">
                <div class="ai-title">
                    <div class="ai-icon">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                    </div>
                    <div>
                        <strong>Quantum AI</strong>
                        <span>Inventory Assistant</span>
                    </div>
                </div>
                <button type="button" class="ai-close-btn" @onclick="CloseAI">✕</button>
            </div>
            <div class="ai-messages">
                @if (_messages.Count == 0)
                {
                    <div class="ai-welcome">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Large" style="color: #00c994;" />
                        <h3>Hi! I'm Quantum AI</h3>
                        <p>Ask me about your inventory, stock levels, equipment status, active projects, or procurement.</p>
                    </div>
                }
                else
                {
                    @foreach (var message in _messages)
                    {
                        <div class="ai-message @(message.IsUser ? "user-message" : "assistant-message")">
                            @message.Text
                        </div>
                    }
                }
                @if (_aiLoading)
                {
                    <div class="ai-message assistant-message">
                        Thinking...
                    </div>
                }
            </div>
            <div class="ai-input-bar">
                <input @bind="_aiInput"
                       @bind:event="oninput"
                       placeholder="Ask Quantum AI about inventory, equipment, projects..."
                       @onkeydown="HandleAIKeyDown" />
                <button type="button"
                        class="ai-send-btn"
                        disabled="@(_aiLoading || string.IsNullOrWhiteSpace(_aiInput))"
                        @onclick="SendAIMessage">
                    ➤
                </button>
            </div>
        </div>
    }
    <button class="ai-floating-button" @onclick="ToggleAI" title="Chat with Quantum AI">
        <MudIcon Icon="@(_aiOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.AutoAwesome)" Size="Size.Medium" />
    </button>
</div>
<div id="blazor-error-ui" data-nosnippet style="display: none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@code {
    private bool _isDarkTheme = true;
    private bool _mobileDrawerOpen = false;
    private string _searchText = string.Empty;
    private bool accountMenuOpen = false;
    private ApplicationSettings? _settings;
    private ApplicationSettings? _currentSettings;
    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#009b72",
            PrimaryContrastText = "#ffffff",
            Secondary = "#00c994",
            Background = "#f5f7f6",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#17211d",
            TextPrimary = "#17211d",
            TextSecondary = "#5e6b66",
            DrawerBackground = "#ffffff"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#009b72",
            PrimaryContrastText = "#ffffff",
            Secondary = "#00c994",
            Background = "#0c110f",
            Surface = "#101614",
            AppbarBackground = "#101614",
            AppbarText = "#f4f7f6",
            TextPrimary = "#f4f7f6",
            TextSecondary = "#87928e",
            DrawerBackground = "#101614"
        }
    };
    protected override async Task OnInitializedAsync()
    {
        _currentSettings = await SettingsService.GetSettingsAsync();
        SettingsService.SettingsUpdated += OnSettingsUpdated;
        try
        {
            _settings = await SettingsService.GetSettingsAsync();
            if (_settings != null)
            {
                _isDarkTheme = !string.Equals(_settings.Theme, "Light", StringComparison.OrdinalIgnoreCase);
            }
        }
        catch
        {
            _isDarkTheme = true;
        }
    }
    private void OnSettingsUpdated(ApplicationSettings updated)
    {
        _settings = updated;
        _isDarkTheme = !string.Equals(updated.Theme, "Light", StringComparison.OrdinalIgnoreCase);
        InvokeAsync(StateHasChanged);
    }
    private async Task ToggleTheme()
    {
        _isDarkTheme = !_isDarkTheme;
        if (_settings != null)
        {
            _settings.Theme = _isDarkTheme ? "Dark" : "Light";
            await SettingsService.UpdateSettingsAsync(_settings);
        }
    }
    private void ToggleMobileDrawer()
    {
        _mobileDrawerOpen = !_mobileDrawerOpen;
    }
    private void CloseMobileDrawer()
    {
        _mobileDrawerOpen = false;
    }
    private void ToggleAccountMenu()
    {
        accountMenuOpen = !accountMenuOpen;
    }
    private void CloseAccountMenu()
    {
        accountMenuOpen = false;
    }
    private string GetUserName(ClaimsPrincipal user)
    {
        return user?.FindFirst("FullName")?.Value ?? user?.Identity?.Name ?? "User";
    }
    private string GetUserEmail(ClaimsPrincipal user)
    {
        return user?.FindFirst(ClaimTypes.Email)?.Value ?? "user@example.com";
    }
    private string GetInitial(ClaimsPrincipal user)
    {
        var name = GetUserName(user);
        return string.IsNullOrEmpty(name) ? "U" : name[0].ToString().ToUpper();
    }
    private bool _aiOpen;
    private bool _aiLoading;
    private string _aiInput = string.Empty;
    private List<AIMessage> _messages = new();
    private void ToggleAI() => _aiOpen = !_aiOpen;
    private void CloseAI() => _aiOpen = false;
    private async Task HandleAIKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendAIMessage();
        }
    }
    private async Task SendAIMessage()
    {
        if (string.IsNullOrWhiteSpace(_aiInput) || _aiLoading)
            return;
        var question = _aiInput.Trim();
        _messages.Add(new AIMessage { Text = question, IsUser = true });
        _aiInput = string.Empty;
        _aiLoading = true;
        try
        {
            var answer = await Orchestrator.GetPersonalizedInventoryAnalysisAsync(question);
            _messages.Add(new AIMessage
            {
                Text = answer ?? "No response received.",
                IsUser = false
            });
        }
        catch (Exception ex)
        {
            _messages.Add(new AIMessage
            {
                Text = $"Service error: {ex.Message}",
                IsUser = false
            });
        }
        finally
        {
            _aiLoading = false;
        }
    }
    private class AIMessage
    {
        public string Text { get; set; } = string.Empty;
        public bool IsUser { get; set; }
    }
    private void HandleSettingsUpdated(ApplicationSettings updatedSettings)
    {
        _currentSettings = updatedSettings;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SettingsService.SettingsUpdated -= HandleSettingsUpdated;
    }
}